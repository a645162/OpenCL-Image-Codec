R"JPEGCL(@JPEG_DEC_SOURCE@)JPEGCL";

const char kJpegEncSource[] =
R"JPEGCL(@JPEG_ENC_SOURCE@)JPEGCL";

}  // namespace jpeg
}  // namespace oic
